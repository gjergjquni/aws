# Copy to .env and fill in real values. The .env file is gitignored — NEVER
# commit the real API key. These variables are read only by the Vite dev
# server process (see vite.config.ts proxy) and by Vercel Edge functions
# (see /api). They are never shipped to the browser bundle.
#
# On Vercel, set the same keys in Project Settings → Environment Variables
# (Production). Do not prefix them with VITE_ — that would leak them into
# the client bundle. AEGIS_API_KEY is required for /api/agent.

# Agent API (Jeta orchestrator) — requires x-api-key, injected server-side.
AEGIS_API_URL=https://xrx4q1jq0k.execute-api.us-east-1.amazonaws.com/prod
AEGIS_API_KEY=your-api-key-here

# Application SAM backend (presigned S3 upload flow).
AEGIS_BACKEND_URL=https://q7phgdg1m5.execute-api.us-east-1.amazonaws.com/Prod

# S3 host of the Aegis evidence bucket (presigned PUTs are proxied here to avoid CORS).
# Must match UPLOAD_BUCKET used by the SAM backend.
# Production (Vercel) proxies /api/backend and /api/evidence via vercel.json
# rewrites — if you change either host, update the matching destination in
# vercel.json too. Vite on Vercel cannot use catch-all [...path] API routes.
AEGIS_EVIDENCE_BUCKET_URL=https://aws-s3-877791042657-us-east-1-an.s3.amazonaws.com
