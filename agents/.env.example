# Reference only. Deployed functions get these from template.yaml; this file
# documents them and supports local_test.py and demo.py.
#
# NEVER put a real secret in this file. The Hive API key lives in AWS Secrets
# Manager. Lambdas authenticate to AWS services with their IAM execution role.
# For local demo, use `aws configure` or the standard AWS credential chain —
# do not paste keys here.
#
# Legend:
#   REQUIRED                 needed for that code path to succeed
#   OPTIONAL                 feature degrades explicitly if unset
#   ONLY_FOR_PRODUCTION      set by SAM/CloudFormation at deploy time
#   ONLY_FOR_LOCAL_DEVELOPMENT useful on a laptop; unused in Lambda

# --- Region -----------------------------------------------------------------
# REQUIRED for local AWS SDK calls. Lambda already has AWS_REGION set.
AWS_REGION=us-east-1

# --- Credentials (ONLY_FOR_LOCAL_DEVELOPMENT) --------------------------------
# Do not set these in Lambda. Use the IAM execution role there.
# Locally, prefer `aws configure` / environment / instance profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Evidence bucket (ONLY_FOR_PRODUCTION for the API path) -----------------
# REQUIRED for POST /claims and the visual agent when reading S3.
# OPTIONAL for local demo, which can pass local_image_paths instead.
EVIDENCE_BUCKET=
EVIDENCE_KEY_PREFIX=uploads/

# --- Claims table (ONLY_FOR_PRODUCTION) -------------------------------------
# REQUIRED in Lambda. OPTIONAL locally — if unset, agent results are not persisted.
DYNAMODB_TABLE=

# --- Bedrock reasoning ------------------------------------------------------
# REQUIRED for Agent 1, Agent 2, and Agent 6 (Nova Pro) model calls.
# Must be a cross-region inference profile ID for Nova.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Bedrock embeddings (Agent 2) -------------------------------------------
# REQUIRED for semantic retrieval. If invocation fails, Agent 2 enters
# documented LEXICAL degraded mode (not silent fake vector search).
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# --- OpenSearch (Agent 2) ---------------------------------------------------
# OPTIONAL. Empty = in-memory cosine similarity over bundled synthetic documents.
# That is a documented degraded mode, not a fake OpenSearch response.
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=aegis-fraud-patterns
VECTOR_SIMILARITY_THRESHOLD=0.72

# --- Rekognition (Agent 1) --------------------------------------------------
# No extra endpoint. Uses the AWS credential chain / Lambda role.
# OPTIONAL in the sense that analysis continues with an explicit limitation
# when Rekognition is denied; results are never fabricated.
REKOGNITION_MAX_LABELS=20
REKOGNITION_MIN_CONFIDENCE=70

# --- Hive (OPTIONAL enrichment for Agent 1) ---------------------------------
# Secrets Manager secret with the Hive V3 Secret Key (field api_key / "api key").
HIVE_SECRET_ID=hive-api-key-1

# --- Optional tuning --------------------------------------------------------
LOG_LEVEL=INFO
ALLOWED_ORIGIN=*
CLAIM_TTL_DAYS=0
MAX_CUSTOMER_TEXT_CHARS=8000
MAX_EVIDENCE_IMAGES=5
MAX_IMAGE_BYTES=15728640
ESCALATE_THRESHOLD=70
REVIEW_THRESHOLD=40
CONFIDENCE_THRESHOLD=0.80
REVIEW_INDEX_NAME=review-status-index
VISUAL_WEIGHT_PCT=60
BEDROCK_READ_TIMEOUT=50
BEDROCK_MAX_TOKENS=2048
